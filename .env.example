# GEMINI_API_KEY: Required for Gemini AI API calls and voice processing.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fast inference engine (Llama-3, Whisper)
GROQ_API_KEY=

# OPENAI_API_KEY / ANTHROPIC_API_KEY: Complementary LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# MySQL / MariaDB Database Connection (kingpc_db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kingpc_db

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

